{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
      ".indexOn": [
        "createdAt",
        "role"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "confessions": {
      ".read": "auth != null && (auth.token.role === 'moderator' || auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
      ".write": false,
      ".indexOn": [
        "status",
        "createdAt",
        "category",
        "authorUid"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['message','category','status','createdAt']) && newData.child('message').isString() && newData.child('message').val().length >= 1 && newData.child('message').val().length <= 1000 && newData.child('status').val().matches(/^(PENDING|PUBLISHED|REJECTED)$/) && newData.child('category').val().matches(/^(love|curhat|school|friendship|life|random)$/)"
      }
    },
    "comments": {
      ".read": "auth != null && (auth.token.role === 'moderator' || auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
      ".write": false,
      ".indexOn": [
        "status",
        "createdAt",
        "confessionId"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['confessionId','message','status','createdAt']) && newData.child('message').isString() && newData.child('message').val().length <= 500 && newData.child('status').val().matches(/^(VISIBLE|HIDDEN|PENDING)$/)"
      }
    },
    "public": {
      "confessions": {
        ".read": true,
        ".write": false,
        ".indexOn": [
          "createdAt",
          "likesCount",
          "category",
          "messageLower"
        ]
      },
      "comments": {
        "$confessionId": {
          ".read": true,
          ".write": false,
          ".indexOn": [
            "createdAt"
          ]
        }
      }
    },
    "reactions": {
      "$confessionId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "reports": {
      ".read": "auth != null && (auth.token.role === 'moderator' || auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
      ".write": false,
      ".indexOn": [
        "status",
        "createdAt",
        "confessionId"
      ]
    },
    "settings": {
      "general": {
        ".read": true,
        ".write": false
      }
    },
    "announcements": {
      ".read": true,
      ".write": false,
      ".indexOn": [
        "createdAt"
      ]
    },
    "audit_logs": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
      ".write": false,
      ".indexOn": [
        "timestamp"
      ]
    },
    "stats": {
      ".read": "auth != null && (auth.token.role === 'moderator' || auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
      ".write": false
    },
    "meta": {
      "adminTick": {
        ".read": "auth != null && (auth.token.role === 'moderator' || auth.token.role === 'admin' || auth.token.role === 'owner') && root.child('users').child(auth.uid).child('role').val() === auth.token.role",
        ".write": false
      }
    },
    "rateLimits": {
      ".read": false,
      ".write": false
    }
  }
}
